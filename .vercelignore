# Files excluded from `vercel` CLI deploys. Vercel builds from source, so
# local build output, deps, secrets and tooling never need uploading.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*

# build output
/.next/
/out/
/build
*.tsbuildinfo

# env files (set these in the Vercel dashboard instead)
.env*

# local tooling
/.claude
/.vscode
/coverage

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# stray screenshots / reference images not used by the site
/src/components/broken-pfps.png
